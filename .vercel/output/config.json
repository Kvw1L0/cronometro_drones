{
  "version": 3,
  "daemons": {},
  "routes": [
    {
      "src": "^/(?:(.+)/)?index(?:\\.html)?/?$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "^/(.*)\\.html/?$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "^(?:/(.*))$",
      "headers": {
        "Permissions-Policy": "camera=*, microphone=*"
      },
      "continue": true
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "^(?!/api).*$",
      "dest": "/404"
    }
  ],
  "overrides": {
    "admin.html": {
      "path": "admin"
    },
    "dashboard.html": {
      "path": "dashboard"
    },
    "index.html": {
      "path": "index"
    },
    "sensor.html": {
      "path": "sensor"
    }
  },
  "crons": []
}
